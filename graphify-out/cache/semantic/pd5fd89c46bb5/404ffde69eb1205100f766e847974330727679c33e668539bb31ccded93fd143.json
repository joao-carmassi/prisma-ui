{"nodes": [{"id": "agents_skills_create_skill_references_best_practices", "label": "Skill Authoring Best Practices", "file_type": "document", "source_file": ".agents/skills/create-skill/references/best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_create_skill_references_best_practices_concise_principle", "label": "Concise is Key Principle", "file_type": "rationale", "source_file": ".agents/skills/create-skill/references/best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The context window is shared across conversation history, other skills' metadata, and the current request, so skill content should be pared down to only what the agent doesn't already know; every paragraph must justify its token cost."}, {"id": "agents_skills_create_skill_references_best_practices_eval_driven", "label": "Evaluation-Driven Skill Development", "file_type": "rationale", "source_file": ".agents/skills/create-skill/references/best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build evaluations before writing extensive documentation so a skill solves real, observed gaps rather than imagined problems: run the agent without the skill, identify failures, build three test scenarios, establish a baseline, then write minimal instructions and iterate against the evaluations."}], "edges": [{"source": "agents_skills_create_skill_references_best_practices", "target": "concept_progressive_disclosure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/create-skill/references/best-practices.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_create_skill_references_best_practices", "target": "concept_degrees_of_freedom", "relation": "references", "confidence": "